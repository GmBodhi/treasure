# Copy to .env. Everything here has a working default.

# --- Local dev (both workspaces) ------------------------------------------
# Port `wrangler dev` serves the API on; the Vite dev server proxies /api here.
API_PORT=8787
# Shared TLS for both dev servers. Drop cert.pem + key.pem in ./certs and both
# serve HTTPS. Camera pages need a secure context on anything but localhost.
TLS_CERT=certs/cert.pem
TLS_KEY=certs/key.pem

# --- apps/web build -------------------------------------------------------
# Absolute URL of the deployed Worker. Leave empty for dev: Vite proxies /api,
# which keeps development same-origin.
VITE_API_BASE=

# --- apps/api -------------------------------------------------------------
# These are Worker vars, set in apps/api/wrangler.jsonc (or `wrangler secret
# put` for anything sensitive) rather than read from this file at runtime.
# Listed here so the full surface is in one place.
#   CORS_ORIGIN=*                  comma-separated origins, or *
#   MAX_TARGET_BYTES=10485760      upload cap for .mind files
#   MAX_SCANS=10000                scan rows kept per experience
