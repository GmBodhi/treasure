# Vite fingerprints everything under /assets, so those files can never change
# behind a given URL — cache them forever.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Compiled MindAR targets. The explicit type matters: the SPA fallback answers
# a missing target with 200 text/html rather than a 404, and the content type is
# what lets the app tell a real bundle from the app's own HTML.
/targets/*
  Content-Type: application/octet-stream
  Cache-Control: public, max-age=86400

# index.html must stay fresh or a deploy is invisible to anyone with it cached.
/
  Cache-Control: no-cache
/index.html
  Cache-Control: no-cache

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: same-origin
  # getUserMedia is gated on this policy as well as on a secure context.
  Permissions-Policy: camera=(self), microphone=(), geolocation=(self)
