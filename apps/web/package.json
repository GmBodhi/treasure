{
  "name": "@treasure-ar/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "React + Vite front end. Deployed to Cloudflare Pages as a static bundle.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "deploy": "wrangler pages deploy dist --project-name treasure-ar",
    "test": "node tools/smoke.mjs && node tools/run-tracking-test.mjs",
    "test:smoke": "node tools/smoke.mjs",
    "test:tracking": "node tools/run-tracking-test.mjs",
    "make:model": "node tools/make-lantern-glb.mjs",
    "compile-target": "node tools/compile-target.mjs"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.9.6"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^5.1.1",
    "aframe": "^1.8.0",
    "mind-ar": "^1.2.5",
    "puppeteer": "^25.8.0",
    "tailwindcss": "^4.3.3",
    "vite": "^8.2.2",
    "wrangler": "^4.125.0"
  }
}
