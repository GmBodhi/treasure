# mind-ar depends on `canvas`, a native module for its Node-side compiler. This
# app never uses that path — targets are compiled in the browser at /studio —
# but npm would still try to build it, which needs a C++ toolchain.
#
# puppeteer's postinstall (a ~150 MB Chrome download) is skipped for the same
# reason: the test runners drive an already-installed Chrome via CHROME_PATH.
ignore-scripts=true
